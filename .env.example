# Fichier d'exemple pour les variables d'environnement
# Copiez ce fichier sous le nom ".env" et remplissez vos clés.

# Clé API OpenAI (pour la correction et structuration avancée du texte)
# Obtenez-la sur : https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-votre_cle_api_ici"

# Clé API Google Cloud Vision (fichier JSON du compte de service)
# Renseignez le CHEMIN ABSOLU vers le fichier JSON téléchargé depuis Google Cloud
# Exemple : C:\Users\VotreNom\Desktop\Projet\cle-google-vision.json
GOOGLE_APPLICATION_CREDENTIALS="chemin_vers_votre_fichier_google.json"
